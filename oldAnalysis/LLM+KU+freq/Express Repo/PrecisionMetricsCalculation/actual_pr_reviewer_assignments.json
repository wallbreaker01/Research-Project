      "pr_number": 6754,
      "pr_title": "feat: add express.asyncHandler helper for async route support",
      "pr_author": "macjik",
      "pr_state": "closed",
      "created_at": "2025-09-10T07:28:58Z",
      "pr_url": "https://github.com/expressjs/express/pull/6754",
      "total_reviews": 1,
      "total_review_comments": 0,
      "actual_reviewers": [
        {
          "reviewer_username": "shivarm",
          "reviewer_id": 91419219,
          "review_state": "COMMENTED",
          "review_body": "@macjik With Express 5, don’t need to handle errors within the route handler explicitly.\r\n\r\nBefore Express 4\r\n\r\n```javascript\r\napp.get('/data', async (req, res, next) => {\r\n  try {\r\n    const result = await fetchData();\r\n    res.send(result);\r\n  } catch (err) {\r\n    next(err);\r\n  }\r\n});\r\n```\r\n\r\nWith Express 5\r\n\r\n```javascript\r\napp.get('/data', async (req, res) => {\r\n  const result = await fetchData();\r\n  res.send(result);\r\n});\r\n\r\n```",
          "submitted_at": "2025-09-10T15:09:45Z",
          "author_association": "CONTRIBUTOR"
        }
      ],
      "unique_reviewers": [
        "shivarm"
      ],
      "review_comment_authors": [],
      "all_participants": [
        "shivarm"
      ]
    },
